# PostgreSQL
DATABASE_URL=postgresql://USER:PASS@localhost:5432/mydb
RECIPES_TABLE=recipies_db
RETRIEVER_CACHE_ENABLED=true
RETRIEVER_CACHE_TTL_SECONDS=86400

# OpenRouter (OpenAI-compatible API via openai Python SDK)
OPENROUTER_API_KEY=
# Optional overrides:
# LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODEL=
LLM_MAX_RETRIES=3
# If >0: log first N chars of raw LLM JSON when JSON/schema validation fails (dev; may echo user text).
# WEEKCHEF_LLM_VALIDATION_PREVIEW_CHARS=400
LLM_TIMEOUT_SECONDS=120
# Orchestrator: LLM meal picking + optional INTAKE parse (see weekchef-plan --llm)
PLANNER_USE_LLM=false
PLANNER_FALLBACK_DETERMINISTIC=true
PIPELINE_MAX_SECONDS=120
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=WeekChef

# Google Calendar (Phase 2)
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_SECRETS_FILE=client_secrets.json
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
CALENDAR_MIN_SLOT_MINUTES=25
CALENDAR_MAX_SLOTS_PER_DAY=12

# Observability (logs + OpenTelemetry traces/metrics)
# WEEKCHEF_LOG_JSON=true
# WEEKCHEF_LOG_LEVEL=INFO
# WEEKCHEF_OTEL_ENABLED=true
# WEEKCHEF_OTEL_TRACES_CONSOLE=true
# WEEKCHEF_OTEL_METRICS_CONSOLE=true
# OTEL_SERVICE_NAME=weekchef
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_INSECURE=true

# Langfuse (optional LLM tracing UI; pip install -e ".[langfuse]")
# WEEKCHEF_LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Telegram (Phase 5)
TELEGRAM_BOT_TOKEN=
# If api.telegram.org is unreachable: HTTP proxy (no extra packages), or SOCKS (needs aiohttp-socks):
# TELEGRAM_PROXY_URL=http://127.0.0.1:7890
# TELEGRAM_PROXY_URL=socks5://127.0.0.1:1080   # then: pip install 'weekchef[telegram_socks]' or aiohttp-socks
# TELEGRAM_API_TIMEOUT_SECONDS=90
